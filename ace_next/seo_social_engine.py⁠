from __future__ import annotations

from typing import Any


def _clean_text(value: Any) -> str:
    return " ".join(str(value or "").strip().split())


def _hashtags_from_trend(trend: str) -> list[str]:
    compact = "".join(ch for ch in trend.title() if ch.isalnum())
    base = f"#{compact}" if compact else "#ACEOmega"
    return [base, "#Retencao", "#Clareza", "#ConteudoPremium", "#Instagram"]


class SeoSocialEngine:
    """
    Gera caption, description e hashtags.
    Não publica. Só prepara metadata para o runtime.
    """

    def build_metadata(
        self,
        trend: str,
        creative_plan: dict[str, Any],
        platform: str = "instagram",
    ) -> dict[str, Any]:
        trend = _clean_text(trend)
        plan = dict(creative_plan or {})

        headline = _clean_text(plan.get("headline") or trend)
        hook = _clean_text(plan.get("hook") or "")
        body = _clean_text(plan.get("body") or "")
        payoff = _clean_text(plan.get("payoff") or "")
        cta = _clean_text(plan.get("cta") or "Salve e envie para alguém que precisa disto.")

        description = _clean_text(" ".join(x for x in [hook, body, payoff] if x))
        caption = _clean_text(" ".join(x for x in [headline, description, cta] if x))
        hashtags = _hashtags_from_trend(trend)

        if platform == "youtube":
            hashtags = hashtags[:3] + ["#Shorts", "#Viral"]
        elif platform == "tiktok":
            hashtags = hashtags[:3] + ["#FYP", "#ParaVoce"]
        elif platform == "threads":
            hashtags = hashtags[:3] + ["#Discussao", "#Opiniao"]

        return {
            "ok": True,
            "platform": platform,
            "title": headline,
            "description": description[:400],
            "caption": caption[:500],
            "hashtags": hashtags[:6],
        }
