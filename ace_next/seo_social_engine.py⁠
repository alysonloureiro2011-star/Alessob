from __future__ import annotations
from typing import Any, Dict

class SeoSocialEngine:
    """
    Gera metadados (título, descrição, hashtags) otimizados por plataforma.
    """

    def build_metadata(
        self,
        trend: str,
        creative_plan: Dict[str, Any],
        platform: str = "instagram",
    ) -> Dict[str, Any]:
        hashtags = [f"#{trend.replace(' ', '')}"]
        title = creative_plan.get("headline") or trend
        description = creative_plan.get("body") or f"Confira tudo sobre {trend}"

        if platform == "youtube":
            hashtags += ["#shorts", "#viral"]
        elif platform == "tiktok":
            hashtags += ["#fyp", "#paravoce"]
        elif platform == "threads":
            hashtags += ["#opiniao", "#discussao"]

        return {
            "ok": True,
            "title": title,
            "description": description,
            "hashtags": hashtags[:5],
            "platform": platform,
        }
