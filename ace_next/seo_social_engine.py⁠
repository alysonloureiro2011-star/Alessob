from __future__ import annotations

from typing import Any, Dict, List

class SeoSocialEngine:
    """
    Gera descrições, hashtags e metadados sociais para otimizar postagens em plataformas diversas.
    """

    def build_metadata(
        self,
        trend: str,
        creative_plan: Dict[str, Any],
        platform: str = "instagram",
    ) -> Dict[str, Any]:
        """
        Produz hashtags e títulos otimizados para a plataforma solicitada.
        """
        hashtags = [f"#{trend.replace(' ', '')}"]
        title = creative_plan.get("headline") or trend
        description = creative_plan.get("body") or f"Confira tudo sobre {trend}"

        if platform == "youtube":
            hashtags += ["#shorts", "#viral"]
        elif platform == "tiktok":
            hashtags += ["#fyp", "#paravoce"]
        elif platform == "threads":
            hashtags += ["#opinião", "#discussão"]

        return {
            "ok": True,
            "title": title,
            "description": description,
            "hashtags": hashtags[:5],
            "platform": platform,
        }
